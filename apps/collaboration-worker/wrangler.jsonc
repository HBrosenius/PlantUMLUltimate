{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "plantuml-ultimate-collaboration",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "collaboration.plantuml.brosenius.se", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "COLLABORATION_ROOM", "class_name": "CollaborationRoom" }],
  },
  "ratelimits": [
    { "name": "ROOM_CREATION_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "ROOM_REQUEST_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CollaborationRoom"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://plantuml.brosenius.se",
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
